{
  "name": "gpt-voxel-3d-staging-01",
  "main": "worker.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "staging",
    "STAGING_WORKER_NAME": "gpt-voxel-3d-staging-01",
    "STAGING_WORKER_ORIGIN": "",
    "ALLOWED_ORIGIN": "",
    "FIREBASE_PROJECT_ID": "",
    "FIREBASE_PUBLIC_CONFIG": "",
    "FIREBASE_APP_CHECK_SITE_KEY": "",
    "FIREBASE_ONLINE_USER_CHECK": "false",
    "STAGING_AUTH_MODE": "popup",
    "PAYMENT_MODE": "provider-neutral-test",
    "TWOC2P_SANDBOX_ENABLED": "false",
    "TWOC2P_SANDBOX_CHECKOUT_ENABLED": "false",
    "TWOC2P_SANDBOX_BACKEND_ENABLED": "false",
    "TWOC2P_SANDBOX_MERCHANT_CAPABILITIES_VERIFIED": "false",
    "TWOC2P_SANDBOX_E2E_VERIFIED": "false",
    "TWOC2P_SANDBOX_E2E_TEST_MODE": "false",
    "TWOC2P_SANDBOX_MONTHLY_POLICY_VERIFIED": "false",
    "TWOC2P_SANDBOX_BILLING_TIMEZONE": "",
    "TWOC2P_SANDBOX_INITIAL_SEQUENCE_NO": "",
    "TWOC2P_SANDBOX_MERCHANT_ID": ""
  },
  "assets": {
    "directory": "work/staging/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "GameRoom" },
      { "name": "ZONE", "class_name": "ZoneRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2-zone-room", "new_sqlite_classes": ["ZoneRoom"] }
  ]
}
