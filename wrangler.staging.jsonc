{
  "name": "gpt-voxel-3d-staging-01",
  "main": "worker.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "staging",
    "STAGING_WORKER_NAME": "gpt-voxel-3d-staging-01",
    "STAGING_WORKER_ORIGIN": "",
    "ALLOWED_ORIGIN": "",
    "FIREBASE_PROJECT_ID": "",
    "FIREBASE_PUBLIC_CONFIG": "",
    "STAGING_AUTH_MODE": "popup",
    "PAYMENT_MODE": "provider-neutral-test"
  },
  "assets": {
    "directory": "work/staging/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "GameRoom" },
      { "name": "ZONE", "class_name": "ZoneRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2-zone-room", "new_sqlite_classes": ["ZoneRoom"] }
  ]
}
